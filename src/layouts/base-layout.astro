---
import { Font } from "astro:assets";

import "@styles/layout.css";
import "@styles/utils-classes.css";
import "@styles/tokens/primitives.css";
import "@styles/tokens/semantic.spec.css";
import "@styles/tokens/semantic.bold.css";

import Header from "@organisms/header/header.astro";
import Footer from "@organisms/footer/footer.astro";

type Props = {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  brand?: "spec" | "bold";
} & (
  | { pageType: "article"; headline: string; datePublished: string; dateModified?: string }
  | { pageType?: "website" | "profile"; headline?: never; datePublished?: never; dateModified?: never }
);

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
  brand = "spec",
  pageType = "website",
  headline,
  datePublished,
  dateModified = datePublished,
} = Astro.props;

if (!Astro.site) {
  throw new Error("Set site in astro.config.mjs to generate absolute metadata URLs.");
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
canonicalURL.pathname = canonicalURL.pathname.replace(/\/+$/, "") || "/";
const imageURL = new URL(image ?? "/assets/social/default.png", Astro.site);
const socialImageAlt = imageAlt ?? (image
  ? undefined
  : "Nico Collin - Frontend Tech Lead. UI foundations teams ship on.");
const person = {
  "@type": "Person",
  "@id": new URL("/#person", Astro.site).href,
  name: "Nico Collin",
  url: new URL("/", Astro.site).href,
  jobTitle: "Frontend tech lead",
  sameAs: ["https://www.linkedin.com/in/ncollin"],
};
const structuredData = pageType === "website" ? undefined : {
  "@context": "https://schema.org",
  "@graph": [
    person,
    pageType === "profile" ? {
      "@type": "ProfilePage",
      "@id": `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: title,
      description,
      inLanguage: "en",
      mainEntity: { "@id": person["@id"] },
    } : {
      "@type": "Article",
      "@id": `${canonicalURL.href}#article`,
      url: canonicalURL.href,
      headline,
      description,
      datePublished,
      dateModified,
      inLanguage: "en",
      image: imageURL.href,
      author: { "@id": person["@id"] },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL.href,
      },
    },
  ],
};
const structuredDataJSON = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="en" data-theme={brand}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        const brand = localStorage.getItem("nc-brand");
        if (brand === "spec" || brand === "bold") {
          document.documentElement.dataset.theme = brand;
        }
      } catch (error) {
        console.warn("Unable to restore the saved brand.", error);
      }
    </script>
    <Font cssVariable="--nc-font-plex-sans" />
    <Font cssVariable="--nc-font-plex-mono" />
    <Font cssVariable="--nc-font-archivo" />
    <Font cssVariable="--nc-font-archivo-black" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalURL.href} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={pageType === "article" ? "article" : "website"} />
    <meta property="og:site_name" content="Nico Collin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={imageURL.href} />
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />
    {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {structuredDataJSON && (
      <script type="application/ld+json" set:html={structuredDataJSON} />
    )}
  </head>
  <body>
    <div class="nc-layout">
      <Header />

      <main class="nc-layout__main">
        <slot />
      </main>

      <Footer />
    </div>
    {Astro.url.pathname === "/" && (
      <div id="nc-page-end" class="nc-page-end" aria-hidden="true"></div>
    )}
  </body>
</html>