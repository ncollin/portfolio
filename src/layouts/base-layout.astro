---
import { Font } from "astro:assets";

import "@styles/layout.css";
import "@styles/utils-classes.css";
import "@styles/tokens/primitives.css";
import "@styles/tokens/semantic.spec.css";
import "@styles/tokens/semantic.bold.css";

import Header from "@organisms/header/header.astro";
import Footer from "@organisms/footer/footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  brand?: "spec" | "bold";
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  brand = "spec",
} = Astro.props;

if (!Astro.site) {
  throw new Error("Set site in astro.config.mjs to generate absolute metadata URLs.");
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
canonicalURL.pathname = canonicalURL.pathname.replace(/\/+$/, "") || "/";
const imageURL = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en" data-theme={brand}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        const brand = localStorage.getItem("nc-brand");
        if (brand === "spec" || brand === "bold") {
          document.documentElement.dataset.theme = brand;
        }
      } catch (error) {
        console.warn("Unable to restore the saved brand.", error);
      }
    </script>
    <Font cssVariable="--nc-font-plex-sans" />
    <Font cssVariable="--nc-font-plex-mono" />
    <Font cssVariable="--nc-font-archivo" />
    <Font cssVariable="--nc-font-archivo-black" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nico Collin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    {imageURL && (
      <>
        <meta property="og:image" content={imageURL.href} />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
      </>
    )}

    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && (
      <>
        <meta name="twitter:image" content={imageURL.href} />
        {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
      </>
    )}
  </head>
  <body>
    <div class="nc-layout">
      <Header />

      <main class="nc-layout__main">
        <slot />
      </main>

      <Footer>
        <p>Site name</p>
      </Footer>
    </div>
  </body>
</html>