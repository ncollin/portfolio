---
import styles from "@organisms/work-list/work-list.module.css";
import SectionHeader from "@molecules/section-header/section-header.astro";

interface Props {
  id?: string;
  title?: string;
}

const { id = "work", title = "Selected work" } = Astro.props;
const headingId = `${id}-heading`;
---

<!-- Only CaseStudyCard components go in the slot: each renders an <li> -->
<section id={id} class={styles["nc-work-list"]} aria-labelledby={headingId}>
  <SectionHeader id={headingId} title={title} />
  <ul class={styles["nc-work-list__cards"]}>
    <slot />
  </ul>
</section>