---
import styles from "@organisms/lesson-list/lesson-list.module.css";
import SectionHeader from "@molecules/section-header/section-header.astro";

interface Props {
  id: string;
  title: string;
  index?: string;
  intro?: string;
}

const { id, title, index, intro } = Astro.props;
const headingId = `${id}-heading`;
---

<!-- Slot: LessonBlock components only (each renders an <li>) -->
<section id={id} class={styles["nc-lesson-list"]} aria-labelledby={headingId}>
  <SectionHeader id={headingId} title={title} index={index} />
  {intro && <p class={styles["nc-lesson-list__intro"]}>{intro}</p>}
  <ul class={styles["nc-lesson-list__lessons"]}>
    <slot />
  </ul>
</section>