---
import styles from "@organisms/card-grid/card-grid.module.css";
import SectionHeader from "@molecules/section-header/section-header.astro";

interface Props {
  id: string;
  title: string;
  index?: string;
  intro?: string;
}

const { id, title, index, intro } = Astro.props;
const headingId = `${id}-heading`;
---

<!-- Slot: InfoCard components only (each renders an <li>) -->
<section id={id} class={styles["nc-card-grid"]} aria-labelledby={headingId}>
  <SectionHeader id={headingId} title={title} index={index} />
  {intro && <p class={styles["nc-card-grid__intro"]}>{intro}</p>}
  <ul class={styles["nc-card-grid__list"]}>
    <slot />
  </ul>
</section>