---
import type { HTMLAttributes } from "astro/types";
import styles from "@atoms/button/button.module.css";

type Props = {
  variant?: "primary" | "secondary";
  href?: string;
} & HTMLAttributes<"a"> & HTMLAttributes<"button">;

const { variant = "primary", href, class: className, ...rest } = Astro.props;
const classes = [styles["nc-button"], styles[`nc-button--${variant}`], className];
const opensInNewTab = rest.target === "_blank";
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
    {opensInNewTab && <span class="visually-hidden"> (opens in a new tab)</span>}
  </a>
) : (
  <button type="button" class:list={classes} {...rest}>
    <slot />
  </button>
)}