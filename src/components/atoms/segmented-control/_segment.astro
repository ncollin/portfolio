---
import styles from"@atoms/segmented-control/_segment.module.css";

interface Props {
  name: string;
  value: string;
  checked?: boolean;
  disabled?: boolean;
  required?: boolean;
}

const {
  name,
  value,
  checked = false,
  disabled = false,
  required = false
} = Astro.props;
---

<label class={styles["nc-segment"]}>
  <input
    type="radio"
    class={styles["nc-segment__input"]}
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    required={required}
  />
  <span class={styles["nc-segment__content"]}>
    <slot />
  </span>
</label>