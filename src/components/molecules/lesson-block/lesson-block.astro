---
import styles from "@molecules/lesson-block/lesson-block.module.css";

interface Props {
  statement: string;
  support: string;
}

const { statement, support } = Astro.props;
---

<li class={styles["nc-lesson-block"]}>
  <h3 class={styles["nc-lesson-block__statement"]}>{statement}</h3>
  <p class={styles["nc-lesson-block__support"]}>{support}</p>
</li>